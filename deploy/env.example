# Copy to deploy/.env and fill in. provision.sh pushes this into the VM.

# Where the embedding endpoint lives — the laptop's tailnet name, since Ollama
# runs there. `tailscale status` on the Mac gives you the name.
#
# If Ollama is the docker container from the dev compose, it already publishes on
# 0.0.0.0 and there is nothing else to do. Only the *native* macOS Ollama app
# binds loopback; for that, use the app's own network-exposure setting or a user
# LaunchAgent — `sudo launchctl setenv` is refused by SIP.
EMBEDDINGS_ENDPOINT=http://your-macbook.your-tailnet.ts.net:11434/v1/embeddings

# Data root inside the VM.
NOTO_DATA=/srv/noto-data

# The hostname Traefik routes on, and that the Tailscale cert is issued for.
# provision.sh fills this in automatically from `tailscale status` after the VM
# joins the tailnet — leave it blank unless you need to override it.
TS_FQDN=

# Where the Tailscale-issued certificate lands on the VM (traefik mounts it).
CERT_DIR=/etc/noto/certs

# API keys
OPENROUTER_KEY=
OPENAI_KEY=
