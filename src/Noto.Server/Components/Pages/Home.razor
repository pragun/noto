@page "/"
@using Noto.Server.Services
@using Noto.Shared.Models
@using Noto.Server.Components.Shared
@inject EntityService Svc
@inject IJSRuntime JS

<div class="page-date">@DateTime.Now.ToString("dddd · MMMM d, yyyy")</div>
<div class="page-title">stream</div>

<!-- Quick capture -->
<div class="quick-capture">
    <div style="display:flex; align-items:center; gap:6px; margin-bottom:6px;">
        <TemplatePicker Templates="templates" OnApply="ApplyTemplate" />
    </div>
    <textarea @bind="newBody" @bind:event="oninput" placeholder="write something..." rows="2"></textarea>
    @if (!string.IsNullOrWhiteSpace(newBody))
    {
        <div class="quick-capture-actions">
            <input type="text" @bind="newTitle" placeholder="title (optional)"
                   style="flex:1; background:transparent; border:1px solid var(--chalk); font-family:inherit; font-size:11px; color:var(--charcoal); padding:6px 10px; outline:none;" />
            <button class="btn-zen primary" @onclick="CreateCapture">save</button>
        </div>
    }
</div>

@if (toast != null)
{
    <div class="toast-msg show">@toast</div>
}

<!-- Stream -->
<div class="note-stream-label">recent captures (@totalCount total)</div>

@if (entities.Count == 0)
{
    <div class="empty-state">
        <div class="icon">▦</div>
        <p>nothing here yet.<br/>type something above, or use the CLI.</p>
    </div>
}
else
{
    string? lastDay = null;
    foreach (var e in entities)
    {
        var day = e.CreatedAt.ToLocalTime().ToString("MMMM d");
        if (day != lastDay)
        {
            <div class="stream-day-sep">@day</div>
            lastDay = day;
        }

        <div class="note-card @GetTypeClass(e.Type)" style="position:relative;" @onclick="() => ViewEntity(e.Id)">
            @if (shiftHeld)
            {
                <button class="shift-delete-btn"
                        @onclick:stopPropagation="true"
                        @onclick="() => QuickDelete(e.Id)">
                    &times;
                </button>
            }
            <div class="note-card-meta">
                <span class="note-type-tag @GetTagClass(e.Type)">@e.Type</span>
                <span class="note-time">@e.CreatedAt.ToLocalTime().ToString("HH:mm")</span>
                <span class="note-id">@e.Id.ToString()[..8]</span>
            </div>
            @if (IsChordSheet(e))
            {
                <div class="note-title">@(GetSongTitle(e) ?? e.Title ?? "(untitled song)")</div>
                <div class="note-preview" style="font-size:10px; color:var(--slate);">@GetSongSummary(e.Body)</div>
            }
            else
            {
                @if (e.Title != null)
                {
                    <div class="note-title">@e.Title</div>
                }
                @if (e.Body != null)
                {
                    <div class="note-preview">@e.Body</div>
                }
            }
            @{
                var threads = e.LinksFrom.Where(l => l.Reason == "tagged" && l.To != null).Select(l => l.To).ToList();
            }
            @if (threads.Count > 0)
            {
                <div class="note-themes">
                    @foreach (var t in threads)
                    {
                        <span class="theme-chip">@t.Title</span>
                    }
                </div>
            }
        </div>
    }

    @if (entities.Count < totalCount)
    {
        <div style="text-align:center; margin:20px 0;">
            <button class="btn-zen" @onclick="LoadMore">load more</button>
        </div>
    }
}

@code {
    private List<Entity> entities = [];
    private List<Entity> templates = [];
    private int page = 0;
    private int totalCount = 0;
    private string newBody = "";
    private string newTitle = "";
    private string? toast;
    private bool shiftHeld;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("noto.registerShiftWatch",
                DotNetObjectReference.Create(this));
        }
    }

    [JSInvokable]
    public void OnShiftChanged(bool pressed)
    {
        shiftHeld = pressed;
        StateHasChanged();
    }

    private async Task QuickDelete(Guid id)
    {
        await Svc.Delete(id);
        await LoadEntities();
        await ShowToast("deleted");
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadEntities();
        templates = await Svc.GetTemplates();
    }

    private async Task LoadEntities()
    {
        entities = await Svc.GetStream(page: 0, pageSize: (page + 1) * 20, excludeChordSheets: true);
        totalCount = await Svc.Count(excludeChordSheets: true);
    }

    private async Task LoadMore()
    {
        page++;
        await LoadEntities();
    }

    private void ApplyTemplate(string body)
    {
        newBody = string.IsNullOrWhiteSpace(newBody) ? body : newBody + "\n\n" + body;
    }

    private async Task CreateCapture()
    {
        if (string.IsNullOrWhiteSpace(newBody)) return;

        var title = string.IsNullOrWhiteSpace(newTitle) ? null : newTitle.Trim();
        await Svc.Create(EntityTypes.Capture, title, newBody.Trim());
        newBody = "";
        newTitle = "";
        page = 0;
        await LoadEntities();
        await ShowToast("captured");
    }

    private async Task ShowToast(string msg)
    {
        toast = msg;
        StateHasChanged();
        await Task.Delay(1500);
        toast = null;
        StateHasChanged();
    }

    [Inject] private NavigationManager Nav { get; set; } = null!;

    private void ViewEntity(Guid id) => Nav.NavigateTo($"/entity/{id}");

    private string GetTypeClass(string type) => type switch
    {
        "capture" => "type-text",
        "thread" => "type-dream",
        _ => ""
    };

    private string GetTagClass(string type) => type switch
    {
        "capture" => "tag-capture",
        "thread" => "tag-thread",
        "stash" => "tag-stash",
        _ => ""
    };

    private bool IsChordSheet(Entity e)
    {
        if (e.Meta == null) return false;
        try
        {
            if (e.Meta.RootElement.TryGetProperty("render", out var r))
                return r.GetString() == "chord-sheet";
        }
        catch { }
        return false;
    }

    private string? GetSongTitle(Entity e)
    {
        if (e.Body == null) return null;
        var m = System.Text.RegularExpressions.Regex.Match(e.Body, @"\{(?:title|t):\s*(.+?)\}");
        return m.Success ? m.Groups[1].Value.Trim() : null;
    }

    private string GetSongSummary(string? body)
    {
        if (body == null) return "";
        var parts = new List<string>();
        var artist = System.Text.RegularExpressions.Regex.Match(body, @"\{(?:artist|a|subtitle|st):\s*(.+?)\}");
        if (artist.Success) parts.Add(artist.Groups[1].Value.Trim());
        var key = System.Text.RegularExpressions.Regex.Match(body, @"\{(?:key|k):\s*(.+?)\}");
        if (key.Success) parts.Add("key " + key.Groups[1].Value.Trim());
        var capo = System.Text.RegularExpressions.Regex.Match(body, @"\{capo:\s*(.+?)\}");
        if (capo.Success && capo.Groups[1].Value.Trim() != "0") parts.Add("capo " + capo.Groups[1].Value.Trim());
        return string.Join(" · ", parts);
    }
}
