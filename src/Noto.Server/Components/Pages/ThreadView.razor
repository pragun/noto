@page "/threads/{Id:guid}"
@using Noto.Server.Services
@using Noto.Shared.Models
@using Noto.Server.Components.Shared
@inject EntityService Svc
@inject AiConversationService AiSvc
@inject NavigationManager Nav

@if (thread == null)
{
    <div class="empty-state"><p>thread not found</p></div>
}
else
{
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:8px;">
        <button class="btn-zen" @onclick="GoBack" style="padding:4px 10px;">←</button>
        <div class="page-title" style="margin-bottom:0;">@thread.Title</div>
    </div>

    @if (thread.Body != null)
    {
        <div style="font-size:12px; color:var(--charcoal-2); font-style:italic; margin-bottom:20px; padding-left:12px; border-left:2px solid var(--matcha-2); line-height:1.7;">
            @thread.Body
        </div>
    }

    <div style="font-size:10px; color:var(--slate); margin-bottom:20px;">
        @captures.Count captures &middot; created @thread.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")
    </div>

    <!-- Tag existing capture -->
    <div class="quick-capture" style="margin-bottom:24px; padding:10px 14px;">
        <div style="font-size:9px; letter-spacing:0.1em; text-transform:uppercase; color:var(--slate); margin-bottom:6px;">add capture to thread</div>
        <EntityPicker Placeholder="search captures to tag..."
                      FilterType="capture"
                      ExcludeIds="taggedCaptureIds"
                      OnPicked="OnCapturePickedForTag" />
    </div>

    @if (toast != null)
    {
        <div class="toast-msg show">@toast</div>
    }

    <hr class="zen-divider" />

    <!-- Timeline -->
    @if (captures.Count == 0)
    {
        <div class="empty-state">
            <div class="icon">∿</div>
            <p>no captures tagged to this thread yet.</p>
        </div>
    }
    else
    {
        string? lastDay = null;
        @foreach (var c in captures)
        {
            var day = c.CreatedAt.ToLocalTime().ToString("MMMM d, yyyy");
            if (day != lastDay)
            {
                <div class="stream-day-sep">@day</div>
                lastDay = day;
            }

            <div style="display:flex; gap:12px; margin-bottom:6px;">
                <!-- Spine -->
                <div style="display:flex; flex-direction:column; align-items:center; width:16px; flex-shrink:0;">
                    <div style="width:8px; height:8px; border-radius:50%; border:2px solid var(--matcha); background:rgba(122,158,126,0.2); margin-top:6px; z-index:1;"></div>
                    <div style="width:1px; flex:1; background:var(--chalk); min-height:8px;"></div>
                </div>

                <!-- Card -->
                <div class="note-card" style="flex:1; cursor:pointer;" @onclick="() => GoToEntity(c.Id)">
                    <div class="note-card-meta">
                        <span class="note-type-tag tag-capture">@c.Type</span>
                        <span class="note-time">@c.CreatedAt.ToLocalTime().ToString("HH:mm")</span>
                        <span class="note-id">@c.Id.ToString()[..8]</span>
                        <button class="btn-zen danger" style="padding:2px 6px; font-size:8px; margin-left:auto;"
                                @onclick:stopPropagation="true"
                                @onclick="() => UntagCapture(c.Id)">untag</button>
                    </div>
                    @if (c.Title != null)
                    {
                        <div class="note-title">@c.Title</div>
                    }
                    @if (c.Body != null)
                    {
                        <div class="note-preview" style="-webkit-line-clamp:4;">@c.Body</div>
                    }
                </div>
            </div>
        }
    }

    <!-- Generate seed -->
    <hr class="zen-divider" />
    <div class="note-stream-label">seed</div>
    @if (generatingSeed)
    {
        <div class="note-card" style="border-left-color:var(--matcha);">
            <div class="note-card-meta">
                <span class="note-type-tag tag-capture">generating...</span>
            </div>
            <div class="note-preview" style="-webkit-line-clamp:6;">@seedContent</div>
        </div>
    }
    else if (latestSeed != null)
    {
        <div class="note-card" style="border-left-color:var(--matcha); cursor:pointer;" @onclick="() => GoToEntity(latestSeed.Id)">
            <div class="note-card-meta">
                <span class="note-type-tag tag-capture">seed</span>
                <span class="note-time">@latestSeed.CreatedAt.ToLocalTime().ToString("MMM d HH:mm")</span>
                <span class="note-id">@latestSeed.Id.ToString()[..8]</span>
            </div>
            <div class="note-preview" style="-webkit-line-clamp:4;">@latestSeed.Body</div>
        </div>
        <div style="display:flex; gap:6px; margin-top:6px;">
            <button class="btn-zen" style="font-size:9px;" @onclick="GenerateSeed">regenerate</button>
        </div>
    }
    else
    {
        <button class="btn-zen primary" @onclick="GenerateSeed" style="margin-bottom:12px;">
            ✦ generate seed from @captures.Count captures
        </button>
    }

    <hr class="zen-divider" />
    <div style="display:flex; gap:8px;">
        <button class="btn-zen" @onclick="GoBack">back to threads</button>
        <button class="btn-zen" @onclick="EditThread">edit</button>
        <button class="btn-zen danger" @onclick="DeleteThread">@(confirmDelete ? "confirm delete" : "delete thread")</button>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Entity? thread;
    private List<Entity> captures = [];
    private string? toast;
    private bool confirmDelete;
    private HashSet<Guid> taggedCaptureIds = [];
    private Entity? latestSeed;
    private bool generatingSeed;
    private string seedContent = "";

    protected override async Task OnParametersSetAsync()
    {
        thread = await Svc.GetById(Id);
        if (thread != null)
        {
            captures = await Svc.GetThreadCaptures(Id);
            taggedCaptureIds = captures.Select(c => c.Id).ToHashSet();
            await FindLatestSeed();
        }
    }

    private async Task FindLatestSeed()
    {
        var links = await Svc.GetLinks(Id);
        var seedLink = links
            .Where(l => l.ToId == Id && l.Reason == "seed-of")
            .OrderByDescending(l => l.CreatedAt)
            .FirstOrDefault();
        latestSeed = seedLink != null ? await Svc.GetById(seedLink.FromId) : null;
    }

    private async Task GenerateSeed()
    {
        if (thread == null || captures.Count == 0 || generatingSeed) return;

        generatingSeed = true;
        seedContent = "";
        StateHasChanged();

        var captureTexts = string.Join("\n\n---\n\n",
            captures.Select(c => $"{c.Title ?? ""}\n{c.Body ?? ""}".Trim()));

        var desc = thread.Body != null ? $"Thread description: {thread.Body}\n\n" : "";
        var prompt = $"Below are {captures.Count} notes from a personal thread called \"{thread.Title}\".\n{desc}"
            + "Synthesize these into a cohesive seed document (300-500 words) that captures:\n"
            + "- The core themes and patterns\n"
            + "- The emotional and intellectual arc\n"
            + "- Key images, phrases, or insights that recur\n"
            + "- Where this thread seems to be heading\n\n"
            + "Write in second person, as if speaking to the person who wrote these notes.\n"
            + "Be specific — use their language and images, not generic observations.\n\n"
            + "Notes:\n" + captureTexts;

        try
        {
            await foreach (var token in AiSvc.StreamResponse(
                "You are a thoughtful synthesizer of personal notes.", [], prompt))
            {
                seedContent += token;
                StateHasChanged();
            }

            // Save as capture, tag to thread, link sources
            var seedEntity = await Svc.Create(EntityTypes.Capture, $"Seed: {thread.Title}", seedContent);
            await Svc.TagCapture(seedEntity.Id, Id);
            await Svc.CreateLink(seedEntity.Id, Id, "seed-of");
            foreach (var cap in captures.Where(c => c.Id != seedEntity.Id))
            {
                await Svc.CreateLink(seedEntity.Id, cap.Id, "sourced-from");
            }

            latestSeed = seedEntity;
            captures = await Svc.GetThreadCaptures(Id);
            taggedCaptureIds = captures.Select(c => c.Id).ToHashSet();
        }
        catch (Exception ex)
        {
            seedContent = $"[Error: {ex.Message}]";
        }

        generatingSeed = false;
        StateHasChanged();
    }

    private async Task OnCapturePickedForTag(Entity picked)
    {
        await Svc.TagCapture(picked.Id, Id);
        captures = await Svc.GetThreadCaptures(Id);
        taggedCaptureIds = captures.Select(c => c.Id).ToHashSet();
        toast = "tagged";
        StateHasChanged();
        await Task.Delay(1500);
        toast = null;
        StateHasChanged();
    }

    private async Task UntagCapture(Guid captureId)
    {
        await Svc.UntagCapture(captureId, Id);
        captures = await Svc.GetThreadCaptures(Id);
    }

    private void GoToEntity(Guid id) => Nav.NavigateTo($"/entity/{id}");
    private void GoBack() => Nav.NavigateTo("/threads");

    private void EditThread() => Nav.NavigateTo($"/entity/{Id}");

    private async Task DeleteThread()
    {
        if (!confirmDelete)
        {
            confirmDelete = true;
            return;
        }
        await Svc.Delete(Id);
        Nav.NavigateTo("/threads");
    }
}
