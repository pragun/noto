@page "/workspace"
@using Noto.Server.Services
@using Noto.Shared.Models
@using Noto.Server.Components.Shared
@using Markdig
@using Microsoft.AspNetCore.Components
@inject EntityService Svc
@inject AiConversationService AiSvc
@inject NavigationManager Nav

<div class="ws-layout">

    <!-- LEFT: Seed Panel -->
    <div class="ws-seed-panel">
        <div class="ws-seed-header">
            <div class="ws-seed-title">context seeds</div>
            <select @bind="selectedThreadId" @bind:after="LoadThreadCaptures"
                    style="width:100%; background:rgba(0,0,0,0.25); border:1px solid rgba(255,255,255,0.08); color:var(--parchment); font-family:inherit; font-size:11px; padding:4px 8px; outline:none; margin-top:8px;">
                <option value="">all captures</option>
                @foreach (var t in threads)
                {
                    <option value="@t.Id">@t.Title</option>
                }
            </select>
        </div>

        <!-- Thread seeds section: existing + generate -->
        @if (!string.IsNullOrEmpty(selectedThreadId))
        {
            <div style="padding:8px 16px; border-bottom:1px solid rgba(255,255,255,0.07);">
                @if (generatingSeed)
                {
                    <div style="font-size:9px; color:var(--matcha-2); letter-spacing:0.1em; margin-bottom:4px;">generating...</div>
                    <div style="font-size:10px; color:rgba(244,239,228,0.5); line-height:1.4; max-height:60px; overflow:hidden;">@seedStreamContent</div>
                }
                else
                {
                    @if (threadSeeds.Count > 0)
                    {
                        <div style="font-size:8px; letter-spacing:0.15em; text-transform:uppercase; color:var(--slate); margin-bottom:6px;">
                            seeds (@threadSeeds.Count)
                        </div>
                        @foreach (var seed in threadSeeds)
                        {
                            var isInjected = injectedSeeds.Any(s => s.Id == seed.Id);
                            var sourceCount = seed.LinksFrom?.Count(l => l.Reason == "sourced-from") ?? 0;
                            <div style="padding:8px 10px; margin-bottom:6px; border-left:2px solid @(isInjected ? "var(--matcha)" : "rgba(122,158,126,0.3)"); background:@(isInjected ? "rgba(122,158,126,0.08)" : "transparent");">
                                <div style="display:flex; align-items:center; gap:6px; margin-bottom:4px;">
                                    <span style="font-size:8px; color:@(isInjected ? "var(--matcha-2)" : "var(--slate-2)"); letter-spacing:0.08em;">
                                        @(isInjected ? "✓ INJECTED" : "✦ SEED") · @seed.CreatedAt.ToLocalTime().ToString("MMM d") · @sourceCount sources
                                    </span>
                                </div>
                                <div style="font-size:10px; line-height:1.6; color:rgba(244,239,228,0.65); max-height:200px; overflow-y:auto; margin-bottom:8px;"
                                     class="ws-seed-body-scroll">
                                    @Truncate(seed.Body ?? "", 600)
                                </div>
                                <div style="display:flex; gap:6px;">
                                    <button @onclick="() => ToggleSeed(seed)"
                                            style="background:rgba(122,158,126,0.25); border:1px solid var(--matcha); color:var(--matcha-2); font-family:inherit; font-size:9px; padding:5px 12px; cursor:pointer;">
                                        @(isInjected ? "remove" : "inject into chat")
                                    </button>
                                    <button @onclick="() => ViewSeedInChat(seed)"
                                            style="background:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.25); color:var(--parchment); font-family:inherit; font-size:9px; padding:5px 12px; cursor:pointer;">
                                        view full
                                    </button>
                                    <button @onclick="() => GoToNote(seed.Id)"
                                            style="background:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.25); color:var(--parchment); font-family:inherit; font-size:9px; padding:5px 12px; cursor:pointer;">
                                        open note
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    <button style="width:100%; background:rgba(122,158,126,0.12); border:1px solid rgba(122,158,126,0.3); color:var(--matcha-2); font-family:inherit; font-size:9px; padding:5px 8px; cursor:pointer; letter-spacing:0.06em; margin-top:4px;"
                            @onclick="GenerateSeed">
                        ✦ @(threadSeeds.Count > 0 ? "regenerate seed" : "generate seed")
                    </button>
                }
            </div>
        }

        @if (injectedSeeds.Count > 0)
        {
            <div style="padding:8px 16px; border-bottom:1px solid rgba(255,255,255,0.07); font-size:9px; color:var(--matcha-2); letter-spacing:0.1em;">
                @injectedSeeds.Count ITEMS IN CONTEXT
                <span style="cursor:pointer; float:right; color:var(--slate);" @onclick="() => injectedSeeds.Clear()">clear</span>
            </div>
        }

        <div class="ws-seed-scroll">
            @foreach (var cap in seedCaptures)
            {
                var isInjected = injectedSeeds.Any(s => s.Id == cap.Id);
                var isSeed = cap.Title?.StartsWith("Seed:") == true;
                <div class="ws-seed-item @(isInjected ? "injected" : "")" @onclick="() => ToggleSeed(cap)">
                    <div class="ws-seed-item-meta">
                        <span style="font-size:8px; letter-spacing:0.1em; text-transform:uppercase; color:@(isInjected ? "var(--matcha-2)" : isSeed ? "rgba(122,158,126,0.7)" : "var(--slate)");">
                            @(isInjected ? "✓ injected" : isSeed ? "✦ seed" : cap.Type)
                        </span>
                    </div>
                    @if (cap.Title != null)
                    {
                        <div class="ws-seed-item-title">@cap.Title</div>
                    }
                    <div class="ws-seed-item-quote">@Truncate(cap.Body ?? "", 150)</div>
                </div>
            }
        </div>
    </div>

    <!-- CENTER: Chat -->
    <div class="ws-composer">
        <div class="ws-topbar">
            <div style="font-size:12px; color:var(--charcoal); font-weight:500; letter-spacing:0.02em;">
                @if (chatEntityId == null)
                {
                    <span style="color:var(--slate);">new conversation</span>
                }
                else
                {
                    <span>@chatTitle</span>
                    <span style="font-size:9px; color:var(--slate-2); margin-left:8px;">@chatEntityId.Value.ToString()[..8]</span>
                }
            </div>
            <div class="ws-topbar-actions">
                <button class="btn-zen" style="font-size:9px; padding:4px 8px;" @onclick="TogglePromptEditor">
                    @(showPromptEditor ? "hide prompt" : "system prompt")
                </button>
                @if (chatEntityId != null)
                {
                    <button class="btn-zen" @onclick="ViewTranscript">view note</button>
                }
                @if (exchanges.Count > 0)
                {
                    <button class="btn-zen" @onclick="NewChat">new chat</button>
                }
            </div>
        </div>

        <!-- System prompt editor -->
        @if (showPromptEditor)
        {
            <div style="margin:0; padding:12px 24px; background:rgba(0,0,0,0.03); border-bottom:1px solid var(--chalk);">
                <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
                    <span style="font-size:8px; letter-spacing:0.15em; text-transform:uppercase; color:var(--slate);">system prompt</span>
                    <select @bind="selectedPromptId" @bind:after="OnPromptSelected"
                            style="background:rgba(255,255,255,0.55); border:1px solid var(--chalk); font-family:inherit; font-size:10px; color:var(--charcoal); padding:3px 6px; outline:none;">
                        <option value="default">default</option>
                        @foreach (var p in savedPrompts)
                        {
                            <option value="@p.Id">@p.Title</option>
                        }
                    </select>
                    <span style="flex:1;"></span>
                    <button class="btn-zen" style="font-size:9px; padding:3px 8px;" @onclick="SaveCurrentPrompt">save as new</button>
                    @if (selectedPromptId != "default")
                    {
                        <button class="btn-zen" style="font-size:9px; padding:3px 8px;" @onclick="UpdateCurrentPrompt">update</button>
                    }
                </div>
                <textarea @bind="activePromptText" @bind:event="oninput"
                          style="width:100%; background:rgba(255,255,255,0.55); border:1px solid var(--chalk); font-family:inherit; font-size:11px; color:var(--charcoal); padding:8px; outline:none; resize:vertical; line-height:1.7; min-height:100px;"
                          rows="6"></textarea>
            </div>
        }

        <!-- Viewing seed inline -->
        @if (viewingSeed != null)
        {
            <div style="margin:12px 24px; background:rgba(74,107,78,0.06); border:1px solid rgba(122,158,126,0.2); border-left:3px solid var(--matcha); padding:14px 18px; max-height:50vh; overflow-y:auto;">
                <div style="display:flex; align-items:center; gap:8px; margin-bottom:10px;">
                    <span style="font-size:8px; letter-spacing:0.15em; text-transform:uppercase; color:var(--matcha-dim);">
                        ✦ @viewingSeed.Title
                    </span>
                    <span style="font-size:9px; color:var(--slate-2);">@viewingSeed.CreatedAt.ToLocalTime().ToString("MMM d HH:mm")</span>
                    <span style="margin-left:auto; display:flex; gap:6px;">
                        <button class="btn-zen" style="font-size:9px; padding:2px 8px;" @onclick="() => GoToNote(viewingSeed.Id)">open note</button>
                        <button class="btn-zen" style="font-size:9px; padding:2px 8px;" @onclick="() => viewingSeed = null">close</button>
                    </span>
                </div>
                <div class="detail-body" style="font-size:12px; line-height:1.8; margin-bottom:0;">@RenderMarkdown(viewingSeed.Body ?? "")</div>
            </div>
        }

        @if (injectedSeeds.Count > 0)
        {
            <div class="ws-context-bar">
                <div class="ws-context-label">@injectedSeeds.Count items as context</div>
                @foreach (var seed in injectedSeeds)
                {
                    <div class="ws-context-item">
                        <span class="ws-context-tag">@Truncate(seed.Title ?? "untitled", 25)</span>
                        @Truncate(seed.Body ?? "", 80)
                    </div>
                }
            </div>
        }

        <div class="ws-editor-scroll">

            @if (exchanges.Count == 0 && !isStreaming)
            {
                <div class="empty-state" style="padding:40px 20px;">
                    <div class="icon">✦</div>
                    <p>inject seeds from the left panel for context,<br/>then start a conversation below.</p>
                </div>
            }

            @for (int i = 0; i < exchanges.Count; i++)
            {
                var exchange = exchanges[i];
                var idx = i;

                <div class="ws-user-msg">
                    <div class="ws-msg-label">you</div>
                    <div class="ws-msg-text" style="white-space:pre-wrap;">@exchange.UserMessage</div>
                </div>

                <div class="ws-ai-response">
                    <div class="ws-msg-label">ai</div>
                    <div class="ws-msg-text detail-body">@RenderMarkdown(exchange.AiResponse)</div>

                    @if (exchange.SavedNoteId == null)
                    {
                        <div class="ws-ai-actions">
                            <button class="ws-ai-action" @onclick="() => SaveResponseAsNote(idx)">
                                save to notes
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="ws-ai-actions">
                            <span style="font-size:9px; color:var(--matcha-dim);">
                                ✓ saved
                            </span>
                            <button class="ws-ai-action" @onclick="() => GoToNote(exchange.SavedNoteId.Value)">
                                @exchange.SavedNoteId.Value.ToString()[..8] → open
                            </button>
                        </div>
                    }
                </div>
            }

            @if (isStreaming)
            {
                <div class="ws-user-msg">
                    <div class="ws-msg-label">you</div>
                    <div class="ws-msg-text" style="white-space:pre-wrap;">@currentUserMsg</div>
                </div>
                <div class="ws-ai-response streaming">
                    <div class="ws-msg-label">ai</div>
                    <div class="ws-msg-text detail-body">@RenderMarkdown(streamingContent)</div>
                </div>
            }
        </div>

        <!-- Prompt bar -->
        <div class="ws-prompt-bar">
            <textarea @bind="promptText" @bind:event="oninput" @onkeydown="OnPromptKeyDown"
                      placeholder="reflect, ask, explore..." rows="2"
                      class="ws-prompt-input"></textarea>
            <button class="ws-prompt-send" @onclick="SendPrompt"
                    disabled="@(isStreaming || string.IsNullOrWhiteSpace(promptText))">
                send
            </button>
        </div>
    </div>

</div>

@code {
    private List<Entity> threads = [];
    private string selectedThreadId = "";
    private List<Entity> seedCaptures = [];
    private List<Entity> injectedSeeds = [];
    private List<Entity> threadSeeds = [];
    private bool generatingSeed;
    private string seedStreamContent = "";
    private Entity? viewingSeed;

    private bool showPromptEditor;
    private string activePromptText = "";
    private string selectedPromptId = "default";
    private List<Entity> savedPrompts = [];

    private string chatTitle = "";
    private Guid? chatEntityId;
    private string promptText = "";
    private bool isStreaming;
    private string streamingContent = "";
    private string currentUserMsg = "";

    private List<Exchange> exchanges = [];
    private List<OpenRouterClient.ChatMessage> conversationHistory = [];

    private class Exchange
    {
        public string UserMessage { get; set; } = "";
        public string AiResponse { get; set; } = "";
        public Guid? SavedNoteId { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        threads = await Svc.GetByType(EntityTypes.Thread);
        savedPrompts = await Svc.GetSystemPrompts();
        activePromptText = AiSvc.DefaultPrompt;
        await LoadThreadCaptures();
    }

    private async Task LoadThreadCaptures()
    {
        threadSeeds = [];

        if (string.IsNullOrEmpty(selectedThreadId))
        {
            seedCaptures = await Svc.GetStream(0, 50, EntityTypes.Capture);
        }
        else
        {
            var threadId = Guid.Parse(selectedThreadId);
            seedCaptures = await Svc.GetThreadCaptures(threadId, 50);

            // Find existing seeds for this thread
            var links = await Svc.GetLinks(threadId);
            var seedIds = links
                .Where(l => l.ToId == threadId && l.Reason == "seed-of")
                .OrderByDescending(l => l.CreatedAt)
                .Select(l => l.FromId)
                .ToList();

            foreach (var seedId in seedIds)
            {
                var seed = await Svc.GetById(seedId);
                if (seed != null) threadSeeds.Add(seed);
            }
        }
    }

    private async Task GenerateSeed()
    {
        if (string.IsNullOrEmpty(selectedThreadId) || generatingSeed) return;

        generatingSeed = true;
        seedStreamContent = "";
        StateHasChanged();

        try
        {
            var threadId = Guid.Parse(selectedThreadId);
            var thread = await Svc.GetById(threadId);
            var captures = seedCaptures.Where(c => c.Title?.StartsWith("Seed:") != true).ToList();

            if (captures.Count == 0 || thread == null)
            {
                generatingSeed = false;
                return;
            }

            var captureTexts = string.Join("\n\n---\n\n",
                captures.Select(c => $"{c.Title ?? ""}\n{c.Body ?? ""}".Trim()));

            var desc = thread.Body != null ? $"Thread description: {thread.Body}\n\n" : "";
            var prompt = $"Below are {captures.Count} notes from a personal thread called \"{thread.Title}\".\n{desc}"
                + "Synthesize these into a cohesive seed document (300-500 words) that captures:\n"
                + "- The core themes and patterns\n"
                + "- The emotional and intellectual arc\n"
                + "- Key images, phrases, or insights that recur\n"
                + "- Where this thread seems to be heading\n\n"
                + "Write in second person, as if speaking to the person who wrote these notes.\n"
                + "Be specific — use their language and images, not generic observations.\n\n"
                + "Notes:\n" + captureTexts;

            await foreach (var token in AiSvc.StreamResponse(
                "You are a thoughtful synthesizer of personal notes.", [], prompt))
            {
                seedStreamContent += token;
                StateHasChanged();
            }

            // Save as capture, tag to thread, link sources
            var seedEntity = await Svc.Create(EntityTypes.Capture, $"Seed: {thread.Title}", seedStreamContent);
            await Svc.TagCapture(seedEntity.Id, threadId);
            await Svc.CreateLink(seedEntity.Id, threadId, "seed-of");
            foreach (var cap in captures)
            {
                await Svc.CreateLink(seedEntity.Id, cap.Id, "sourced-from");
            }

            // Refresh
            await LoadThreadCaptures();
        }
        catch (Exception ex)
        {
            seedStreamContent = $"[Error: {ex.Message}]";
        }

        generatingSeed = false;
        StateHasChanged();
    }

    private void ToggleSeed(Entity cap)
    {
        if (injectedSeeds.Any(s => s.Id == cap.Id))
            injectedSeeds.RemoveAll(s => s.Id == cap.Id);
        else
            injectedSeeds.Add(cap);
    }

    private async Task SendPrompt()
    {
        if (string.IsNullOrWhiteSpace(promptText) || isStreaming) return;

        currentUserMsg = promptText.Trim();
        promptText = "";
        isStreaming = true;
        streamingContent = "";
        StateHasChanged();

        if (string.IsNullOrWhiteSpace(chatTitle) && exchanges.Count == 0)
        {
            chatTitle = currentUserMsg.Length > 60
                ? currentUserMsg[..57] + "..."
                : currentUserMsg;
        }

        var seeds = injectedSeeds
            .Select(s => (s.Title ?? "untitled", s.Body ?? ""))
            .ToList();

        var systemPrompt = AiSvc.BuildSystemPromptWithSeeds(seeds, activePromptText);

        try
        {
            await foreach (var token in AiSvc.StreamResponse(systemPrompt, conversationHistory, currentUserMsg))
            {
                streamingContent += token;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            streamingContent += $"\n\n[Error: {ex.Message}]";
        }

        conversationHistory.Add(new OpenRouterClient.ChatMessage("user", currentUserMsg));
        conversationHistory.Add(new OpenRouterClient.ChatMessage("assistant", streamingContent));
        exchanges.Add(new Exchange { UserMessage = currentUserMsg, AiResponse = streamingContent });

        isStreaming = false;
        currentUserMsg = "";

        await AutoSaveTranscript();

        streamingContent = "";
        StateHasChanged();
    }

    private void OnPromptKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.MetaKey || e.CtrlKey))
            _ = SendPrompt();
    }

    private async Task AutoSaveTranscript()
    {
        var body = string.Join("\n\n---\n\n", exchanges.Select(e =>
            $"**You:**\n{e.UserMessage}\n\n**Claude:**\n{e.AiResponse}"));

        var title = chatTitle != "" ? chatTitle : $"chat · {DateTime.Now:MMM d HH:mm}";

        if (chatEntityId == null)
        {
            var entity = await Svc.Create(EntityTypes.Chat, title, body);
            chatEntityId = entity.Id;
        }
        else
        {
            await Svc.Update(chatEntityId.Value, title: title, body: body);
        }
    }

    private async Task SaveResponseAsNote(int exchangeIdx)
    {
        var exchange = exchanges[exchangeIdx];
        var title = chatTitle != "" ? $"from: {chatTitle}" : "AI reflection";
        var entity = await Svc.Create(EntityTypes.Capture, title, exchange.AiResponse);
        exchange.SavedNoteId = entity.Id;
        StateHasChanged();
    }

    private void TogglePromptEditor() => showPromptEditor = !showPromptEditor;

    private void OnPromptSelected()
    {
        if (selectedPromptId == "default")
        {
            activePromptText = AiSvc.DefaultPrompt;
        }
        else
        {
            var prompt = savedPrompts.FirstOrDefault(p => p.Id.ToString() == selectedPromptId);
            if (prompt != null)
                activePromptText = prompt.Body ?? "";
        }
    }

    private async Task SaveCurrentPrompt()
    {
        var name = $"prompt · {DateTime.Now:MMM d HH:mm}";
        var entity = await Svc.CreateSystemPrompt(name, activePromptText);
        savedPrompts = await Svc.GetSystemPrompts();
        selectedPromptId = entity.Id.ToString();
    }

    private async Task UpdateCurrentPrompt()
    {
        if (selectedPromptId == "default") return;
        var id = Guid.Parse(selectedPromptId);
        await Svc.Update(id, body: activePromptText);
        savedPrompts = await Svc.GetSystemPrompts();
    }

    private void ViewSeedInChat(Entity seed) => viewingSeed = seed;
    private void GoToNote(Guid id) => Nav.NavigateTo($"/entity/{id}");
    private void ViewTranscript() => Nav.NavigateTo($"/entity/{chatEntityId}");

    private void NewChat()
    {
        exchanges = [];
        conversationHistory = [];
        chatTitle = "";
        chatEntityId = null;
        promptText = "";
        injectedSeeds.Clear();
    }

    private string Truncate(string s, int max) =>
        s.Length <= max ? s : s[..max] + "...";

    private static readonly MarkdownPipeline MdPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();

    private MarkupString RenderMarkdown(string md) =>
        new(Markdown.ToHtml(md ?? "", MdPipeline));
}
